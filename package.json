{
  "name": "bb10-development-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Momentics-free BlackBerry 10 native development using the host Node.js",
  "engines": { "node": ">=20" },
  "scripts": {
    "setup:references": "node tools/fetch-references.mjs",
    "setup:sdk": "node tools/bb10.mjs setup-sdk",
    "doctor": "node tools/bb10.mjs doctor",
    "build": "node tools/bb10.mjs build",
    "package": "node tools/bb10.mjs package",
    "build:simulator": "node tools/bb10.mjs build --simulator",
    "package:simulator": "node tools/bb10.mjs package --simulator",
    "verify:simulator": "node tools/bb10.mjs verify --simulator",
    "deploy:simulator": "node tools/bb10.mjs deploy --simulator",
    "setup:simulator": "node tools/simulator.mjs setup",
    "setup:simulator-gui": "bash emulator/runtime/setup-gui.sh",
    "doctor:simulator": "node tools/simulator.mjs doctor",
    "simulator:start": "node tools/simulator.mjs start",
    "simulator:vmvga": "bash emulator/runtime/run.sh 3d",
    "simulator:passport": "bash emulator/runtime/passport.sh",
    "simulator:passport:gui": "bash emulator/runtime/passport-gui.sh",
    "simulator:passport:status": "node tools/simulator.mjs status --state emulator/state/vmvga-gtk-passport",
    "simulator:passport:stop": "node tools/simulator.mjs stop --state emulator/state/vmvga-gtk-passport",
    "simulator:passport:screenshot": "node tools/simulator.mjs screenshot --state emulator/state/vmvga-gtk-passport",
    "simulator:gui": "BB10_DISPLAY=gtk bash emulator/runtime/run.sh 3d",
    "simulator:status": "node tools/simulator.mjs status",
    "simulator:stop": "node tools/simulator.mjs stop",
    "simulator:screenshot": "node tools/simulator.mjs screenshot",
    "verify": "node tools/bb10.mjs verify",
    "deploy": "node tools/bb10.mjs deploy",
    "audit:references": "node tools/audit-references.mjs"
  }
}
